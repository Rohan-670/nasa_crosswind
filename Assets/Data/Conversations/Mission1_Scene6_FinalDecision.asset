  Lines:
  - Speaker: 0
    Expression: 4
    DialogueText: "We have three possible recovery strategies. Each has different risks."
    EducationalConceptNote: "Decision matrix: comparing time, crew risk, and power consumption."
    VoiceClip: {fileID: 0}
    DelayAfterLine: 0.5
    RequirePlayerClickToAdvance: 1
    Framing: 2
    CrewReactions: []
  Choices:
  - ChoiceText: "Strategy A: Elena's Spacewalk (Fast manual cable splice)"
    EducationalHint: "High speed, moderate crew risk, consumes suit O2."
    ResultingConversationId: "Mission1_Scene6_Choice_Elena"
    EmergencyOption: 1
  - ChoiceText: "Strategy B: Marcus's Robotic Rover (Remote arm welding)"
    EducationalHint: "100% safe for crew, consumes high battery reserves."
    ResultingConversationId: "Mission1_Scene6_Choice_Marcus"
    EmergencyOption: 2
  - ChoiceText: "Strategy C: Daniel's Power Reroute (Conserve & delay)"
    EducationalHint: "Zero external hazard, temporarily dims habitat heat."
    ResultingConversationId: "Mission1_Scene6_Choice_Daniel"
    EmergencyOption: 3
