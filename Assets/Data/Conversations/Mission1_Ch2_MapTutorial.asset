  Lines:
  - Speaker: 4
    Expression: 0
    DialogueText: "Navigational guidance ready. The interactive station map displays your live position, outpost structures, and active objectives."
    EducationalConceptNote: "Top-down cartography prevents orientation loss in featureless lunar terrain."
    VoiceClip: {fileID: 0}
    DelayAfterLine: 0.5
    RequirePlayerClickToAdvance: 1
    Framing: 5
    CrewReactions: []
  - Speaker: 1
    Expression: 0
    DialogueText: "Don't forget to plot waypoints if you venture beyond the habitat perimeter toward the solar farm."
    EducationalConceptNote: "Waypoints calculate line-of-sight distance and elevation changes."
    VoiceClip: {fileID: 0}
    DelayAfterLine: 0.5
    RequirePlayerClickToAdvance: 1
    Framing: 1
    CrewReactions: []
  - Speaker: 0
    Expression: 0
    DialogueText: "All crew members must confirm destination coordinates on the map before commencing EVA maneuvers."
    EducationalConceptNote: "Surface navigation protocol ensures astronauts never exceed communications range."
    VoiceClip: {fileID: 0}
    DelayAfterLine: 0.5
    RequirePlayerClickToAdvance: 1
    Framing: 1
    CrewReactions: []
