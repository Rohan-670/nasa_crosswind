  m_Script: {fileID: 11500000, guid: 5d17d177157259c5a2e4ba5d23bfc8b9, type: 3}
  m_Name: Mission1_Scene1_SolarWarning
  m_EditorClassIdentifier: 
  ConversationId: Mission1_Scene1_SolarWarning
  MissionChapter: 'Chapter 3: The First Warning'
  TriggerType: 4
  IsGroupDiscussion: 1
  IsCinematicConversation: 0
  Lines:
  - Speaker: 2
    Expression: 2
    DialogueText: "The solar monitoring data is showing an unusual increase in activity."
    EducationalConceptNote: "Solar storms emit high-energy proton streams called Coronal Mass Ejections."
    VoiceClip: {fileID: 0}
    DelayAfterLine: 0.5
    RequirePlayerClickToAdvance: 1
    Framing: 1
    CrewReactions: []
  - Speaker: 1
    Expression: 2
    DialogueText: "That could affect the external power equipment."
    EducationalConceptNote: "Intense solar particles can trigger electrical arcing in high-voltage lunar cables."
    VoiceClip: {fileID: 0}
    DelayAfterLine: 0.5
    RequirePlayerClickToAdvance: 1
    Framing: 1
    CrewReactions: []
  - Speaker: 0
    Expression: 4
    DialogueText: "Let's monitor the situation. No unnecessary external activity until we understand it."
    EducationalConceptNote: "Commander priority: astronaut safety comes before extravehicular tasks."
    VoiceClip: {fileID: 0}
    DelayAfterLine: 0.5
    RequirePlayerClickToAdvance: 1
    Framing: 2
    CrewReactions: []
  - Speaker: 4
    Expression: 5
    DialogueText: "Solar activity warning registered."
    EducationalConceptNote: "ORION continuously tracks deep-space weather sensors."
    VoiceClip: {fileID: 0}
    DelayAfterLine: 0.5
    RequirePlayerClickToAdvance: 1
    Framing: 5
    CrewReactions: []
  Choices:
  NextConversationId: 'Mission1_Scene2_BeforeImpact'
  OnConversationCompleted:
    m_PersistentCalls:
      m_Calls: []
