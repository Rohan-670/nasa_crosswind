  m_Script: {fileID: 11500000, guid: 5d17d177157259c5a2e4ba5d23bfc8b9, type: 3}
  m_Name: Mission1_Ch2_GreenhouseIntro
  m_EditorClassIdentifier: 
  ConversationId: Mission1_Ch2_GreenhouseIntro
  MissionChapter: 'Chapter 2: Outpost Establishment'
  TriggerType: 1
  IsGroupDiscussion: 1
  IsCinematicConversation: 0
  Lines:
  - Speaker: 2
    Expression: 1
    DialogueText: "Welcome to the greenhouse module! Aeroponic mist delivers nutrients directly to plant roots without soil."
    EducationalConceptNote: "Aeroponics uses 95% less water than traditional terrestrial agriculture."
    VoiceClip: {fileID: 0}
    DelayAfterLine: 0.5
    RequirePlayerClickToAdvance: 1
    Framing: 1
    CrewReactions: []
  - Speaker: 1
    Expression: 0
    DialogueText: "LED lighting is drawing 4.2 kW from our ridge solar panels, replicating an optimal 16-hour daylight cycle."
    EducationalConceptNote: "Plants absorb red and blue light spectra most effectively for photosynthesis."
    VoiceClip: {fileID: 0}
    DelayAfterLine: 0.5
    RequirePlayerClickToAdvance: 1
    Framing: 1
    CrewReactions: []
  - Speaker: 3
    Expression: 0
    DialogueText: "Fresh greens and legumes will supplement our sealed rations and provide essential vitamins."
    EducationalConceptNote: "Fresh vegetables boost crew immune response and maintain psychological wellbeing."
    VoiceClip: {fileID: 0}
    DelayAfterLine: 0.5
    RequirePlayerClickToAdvance: 1
    Framing: 1
    CrewReactions: []
  - Speaker: 0
    Expression: 0
    DialogueText: "A sustainable lunar outpost depends on closed-loop biology. Every plant helps us breathe."
    EducationalConceptNote: "Plants absorb crew-exhaled CO2 and release fresh breathable oxygen."
    VoiceClip: {fileID: 0}
    DelayAfterLine: 0.5
    RequirePlayerClickToAdvance: 1
    Framing: 1
    CrewReactions: []
  - Speaker: 4
    Expression: 0
    DialogueText: "Greenhouse photosynthetic cycle initialized. Biomass health: 100% nominal."
    EducationalConceptNote: "ORION balances humidity, CO2 ppm, and water mist timing in real-time."
    VoiceClip: {fileID: 0}
    DelayAfterLine: 0.5
    RequirePlayerClickToAdvance: 1
    Framing: 5
    CrewReactions: []
  Choices: []
  NextConversationId: ''
  OnConversationCompleted:
    m_PersistentCalls:
      m_Calls: []
