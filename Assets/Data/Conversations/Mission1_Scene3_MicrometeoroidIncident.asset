  ConversationId: Mission1_Scene3_MicrometeoroidIncident
  MissionChapter: 'Chapter 3: The Micrometeoroid Incident'
  TriggerType: 3
  IsGroupDiscussion: 1
  IsCinematicConversation: 0
  Lines:
  - Speaker: 4
    Expression: 5
    DialogueText: "Warning! External equipment impact detected."
    EducationalConceptNote: "Micrometeoroids travel over 20 kilometers per second in the lunar vacuum."
    VoiceClip: {fileID: 0}
    DelayAfterLine: 0.5
    RequirePlayerClickToAdvance: 1
    Framing: 5
    CrewReactions: []
  - Speaker: 2
    Expression: 5
    DialogueText: "That impact appears to have damaged the external assembly."
    EducationalConceptNote: "High-velocity impacts cause kinetic shearing on metal conduit shielding."
    VoiceClip: {fileID: 0}
    DelayAfterLine: 0.5
    RequirePlayerClickToAdvance: 1
    Framing: 1
    CrewReactions: []
  - Speaker: 1
    Expression: 2
    DialogueText: "I'm checking the power distribution now."
    EducationalConceptNote: "Power grids use automated breaker switches to isolate damaged lines."
    VoiceClip: {fileID: 0}
    DelayAfterLine: 0.5
    RequirePlayerClickToAdvance: 1
    Framing: 1
    CrewReactions: []
  - Speaker: 0
    Expression: 3
    DialogueText: "Everyone, report your status."
    EducationalConceptNote: "Standard emergency protocol: immediate headcount and integrity confirmation."
    VoiceClip: {fileID: 0}
    DelayAfterLine: 0.5
    RequirePlayerClickToAdvance: 1
    Framing: 2
    CrewReactions: []
  Choices:
  NextConversationId: 'Mission1_Scene4_LifeSupportEmergency'
  OnConversationCompleted:
    m_PersistentCalls:
      m_Calls: []
